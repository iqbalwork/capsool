<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="st_a11y_title">Layanan aksesibilitas</string>
    <string name="st_a11y_on">Berjalan. Kapsul muncul di atas aplikasi lain saat ada kejadian, seperti charger, notifikasi, atau musik. Agar selalu terlihat, aktifkan \"Selalu tampilkan pil\" di tab Capsule.</string>
    <string name="st_a11y_off">Mati. Aktifkan Capsool di setelan Aksesibilitas untuk menampilkan kapsul.</string>
    <string name="st_a11y_open">Buka setelan Aksesibilitas</string>
    <string name="st_notif_title">Akses notifikasi</string>
    <string name="st_notif_on">Aktif. Kapsul dapat mengikuti pemutar musik dan video.</string>
    <string name="st_notif_off">Mati. Diperlukan untuk menampilkan yang sedang diputar dan mengontrolnya dari kapsul. Capsool hanya membaca notifikasi di ponsel ini dan tidak pernah menyimpan isinya.</string>
    <string name="st_notif_allow">Izinkan akses notifikasi</string>
    <string name="st_restricted_title">Opsi tidak bisa dipilih?</string>
    <string name="st_restricted_body">Di Android 13+, aplikasi yang dipasang di luar Play Store diblokir dari akses Aksesibilitas dan notifikasi. Buka Info aplikasi, ketuk ⋮ lalu pilih \"Izinkan setelan terbatas\", kemudian coba lagi.</string>
    <string name="st_restricted_open">Buka Info aplikasi</string>
    <string name="st_ap_title">Perlindungan Lanjutan aktif</string>
    <string name="st_ap_body">Perlindungan Lanjutan Android dapat mematikan layanan aksesibilitas yang bukan alat bantu, sehingga kapsul berhenti. Capsool tidak dapat mengatasi hal ini.</string>
    <string name="st_keepalive_title">Jaga kapsul tetap berjalan</string>
    <string name="st_keepalive_body">Sebagian ponsel menghentikan aplikasi latar belakang untuk menghemat baterai sehingga kapsul menghilang. Ikuti langkah ini sekali saja.</string>
