<?xml version="1.0" encoding="utf-8"?>
<!--
  Capsool's settings can hold personal content: barcode and loyalty-card numbers, phone numbers on
  contact shortcuts, and which apps are hidden. They stay out of Google cloud backup, but still
  move with a direct phone-to-phone transfer (device-transfer has no excludes, so everything is
  copied). The settings live in DataStore: files/datastore/.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
