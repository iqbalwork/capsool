<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android 12 backup rules. minSdk is 31, so data_extraction_rules.xml is what applies; this
  mirrors it so the two never disagree if minSdk is ever lowered.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
