<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Wi-Fi connected/disconnected events (F-63). Normal permission, granted at install. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Headphone events (F-62): asked at runtime only when the user turns that event on. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Brightness slider and auto-brightness toggle (F-52). Special access, granted by the user
         in Settings when they first use brightness control. -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Switching to or from silent while Do Not Disturb rules apply (F-50). Special access. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Read-only check so the status screen can warn about Android Advanced Protection (F-97). -->
    <uses-permission android:name="android.permission.QUERY_ADVANCED_PROTECTION_MODE" />

    <!-- ML Kit drags in com.google.android.datatransport (its logging transport), which injects
         INTERNET into the merged manifest. The spec says this app does not use INTERNET, and
         on-device barcode scanning never needs it, so the merged permission is stripped here. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <!-- Lets Capsool read the names and icons of launchable apps (notification sources, app lists).
         Narrower than QUERY_ALL_PACKAGES, which is not used. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".CapsoolApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Capsule">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Capsule"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".platform.accessibility.CapsoolAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <!-- Notification access: active media sessions (M1); notifications in the capsule (M2). -->
        <service
            android:name=".platform.notification.CapsoolNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting|ongoing|silent" />
        </service>
    </application>

</manifest>
