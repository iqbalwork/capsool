<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only additions: lets DiagnosticsPanel post real test notifications. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <receiver
            android:name=".debugtools.DebugNotificationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.iqbalwork.capsule.debug.REPLY" />
                <action android:name="com.iqbalwork.capsule.debug.READ" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".debugtools.DebugTimerReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.iqbalwork.capsule.debug.TIMER_ADD" />
                <action android:name="com.iqbalwork.capsule.debug.TIMER_PAUSE" />
                <action android:name="com.iqbalwork.capsule.debug.TIMER_STOP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
